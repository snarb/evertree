{
  "evaluation_kind": "curated_structural_routes",
  "limitations": "These authored scenarios check representation distinctions and traversable routes; they do not measure LLM navigation success or the prevalence of user tasks.",
  "scenarios": [
    {
      "id": "language",
      "intent": "Find the system of syntax and semantics in which source programs are expressed.",
      "target": "local.programming_language",
      "not_targets": [
        "local.source_code",
        "local.compiler",
        "local.software_execution"
      ],
      "expected_ancestors": [
        "local.formal_language"
      ]
    },
    {
      "id": "source-code",
      "intent": "Find the program text edited in a repository, rather than its language or its execution.",
      "target": "local.source_code",
      "not_targets": [
        "local.programming_language",
        "local.compiler",
        "local.software_execution"
      ],
      "expected_ancestors": [
        "local.software_artifact"
      ]
    },
    {
      "id": "compiler",
      "intent": "Find the software tool that translates a program representation.",
      "target": "local.compiler",
      "not_targets": [
        "local.compilation",
        "local.programming_language",
        "local.source_code"
      ],
      "expected_ancestors": [
        "local.software_tool"
      ]
    },
    {
      "id": "compilation",
      "intent": "Find the translation process performed by a compiler during a build.",
      "target": "local.compilation",
      "not_targets": [
        "local.compiler",
        "local.machine_code"
      ],
      "expected_ancestors": [
        "local.computational_process"
      ]
    },
    {
      "id": "algorithm",
      "intent": "Find an abstract prescribed computation independently of one coded implementation.",
