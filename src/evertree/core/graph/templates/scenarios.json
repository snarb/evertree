        "local.computation_result"
      ],
      "expected_ancestors": [
        "local.procedure"
      ]
    },
    {
      "id": "implementation",
      "intent": "Find a software realization of an abstract algorithm.",
      "target": "local.algorithm_implementation",
      "not_targets": [
        "local.algorithm",
        "local.software_execution",
        "local.computation_result"
      ],
      "expected_ancestors": [
        "local.software_artifact"
      ]
    },
    {
      "id": "execution",
      "intent": "Find the process of running an implementation in an environment.",
