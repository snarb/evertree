{
  "evaluation_kind": "curated_structural_routes",
  "limitations": "These independent authored intentions test representation distinctions and traversable routes; they do not measure LLM navigation, curriculum completeness or task prevalence.",
  "scenarios": [
    {
      "id": "world-math-equation",
      "intent": "Find the symbolic equality with unknown variables whose admissible values must be determined.",
      "target": "local.algebraic_equation",
      "not_targets": [
        "local.theorem",
        "local.numeral"
      ],
      "expected_ancestors": [
        "local.mathematical_expression"
      ]
    },
    {
      "id": "world-math-number-representation",
      "intent": "Find a notation used to write a number, independently of the number itself.",
      "target": "local.numeral",
      "not_targets": [
        "sumo.number",
        "local.mathematical_variable"
      ],
      "expected_ancestors": [
        "local.mathematical_expression"
      ]
    },
    {
      "id": "world-math-circle-boundary",
      "intent": "Find the plane geometric boundary at a fixed distance from a center.",
      "target": "local.circle",
      "not_targets": [
        "local.disk",
        "local.sphere"
      ],
      "expected_ancestors": [
        "local.geometric_figure"
      ]
    },
    {
